PORT=5000
NODE_ENV=development
AUTH_SERVICE_URL=https://auth-service:4001
AUTH_PUBLIC_KEY_PATH=/run/keys/public.pem
AUTH_CA_CERT_PATH=/run/keys/tls.crt
SERVICE_TOKEN=change_me_service_token_between_auth_stego
JWT_ISSUER=intilink-auth
JWT_AUDIENCE=intilink-services
