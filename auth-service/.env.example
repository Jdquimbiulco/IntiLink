PORT=4000
INTERNAL_PORT=4001
NODE_ENV=development
DATABASE_URL=postgres://auth_user:auth_pass@auth-db:5432/auth_db
JWT_PRIVATE_KEY_PATH=/run/keys/private.pem
JWT_PUBLIC_KEY_PATH=/run/keys/public.pem
TLS_KEY_PATH=/run/keys/tls.key
TLS_CERT_PATH=/run/keys/tls.crt
JWT_ISSUER=intilink-auth
JWT_AUDIENCE=intilink-services
JWT_EXPIRES_IN=15m
SERVICE_TOKEN=change_me_service_token_between_auth_stego
BCRYPT_OR_ARGON=argon2
